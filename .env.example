APP_NAME=wawayu-ai-service
APP_ENV=development
LOG_LEVEL=INFO

AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-api-key
AI_TIMEOUT_SECONDS=30
AI_STRUCTURED_OUTPUT_METHOD=function_calling

# Server-to-server authentication for protected AI capability endpoints.
AI_SERVICE_API_KEY=replace-with-a-long-random-value
